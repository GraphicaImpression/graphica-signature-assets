<?xml version="1.0" encoding="UTF-8"?>
<!--
  Graphica Signature Preview — Outlook Add-in manifest.

  DEFAULT SIGNATURE STAYS PREVIEW-ONLY: for the everyday, automatic
  signature, this add-in still never writes into the message body — that one
  keeps coming from the Exchange transport rule, invisible until the email
  arrives, so it never conflicts with someone's personal signed-sentences.

  VARIANTS CAN BE INSERTED: the "Autres signatures disponibles" list (for
  occasional cases like writing on a colleague's behalf) can insert its
  chosen HTML directly into the message being written, via
  item.body.setSignatureAsync, and flags that one message with a hidden
  internet header (item.internetHeaders — requires Mailbox 1.8) so the
  Exchange transport rule knows to skip its own stamp on it instead of
  double-appending. See Deploy-Signature.ps1 for the matching rule
  exception.

  RECOVERY LAYER (added later): item.body.setSignatureAsync has no
  documented interaction with Outlook's own NATIVE personal signature
  feature — someone picking one of their own saved signatures (e.g. a
  "merci, nous vous recontacterons" text) from Outlook's own menu silently
  replaces the ENTIRE body we inserted, ours included, while the header
  above stays set. There is no way to prevent that visual swap itself. As a
  safety net, every generated signature also carries a hidden, invisible
  marker of literal text (see SIGNATURE_MARKER_TEXT in taskpane.js,
  launchevent.js, and the Console's generate()). Two independent checks for
  that marker exist:
    1. taskpane.js checks it on a timer/focus while its pane is open, and
       can queue item.body.appendOnSendAsync as a fix — but ONLY while the
       pane stays open (Outlook stops running a pane's code once it's
       closed), and ONLY by queuing ahead of time, since Office.js
       documents appendOnSendAsync as erroring if called from an on-send
       handler itself.
    2. launchevent.js (added later still) is a Smart Alerts OnMessageSend
       handler that runs automatically at the exact moment Send is
       clicked, on every message, whether or not the pane was ever opened.
       It cannot silently rewrite the body (same appendOnSendAsync
       restriction), so instead it briefly blocks the send with a clear
       message and a button that reopens the pane to fix it, if the header
       says a signature was inserted but the marker has gone missing.
  Deploy-Signature.ps1 also checks for the same marker text server-side as
  a third, independent backstop. This is why the Mailbox requirement set
  below is 1.9 (item.internetHeaders / appendOnSendAsync); the nested
  VersionOverridesV1_1 block further down additionally requires 1.15 for
  the OnMessageSend LaunchEvent itself — a client below 1.15 simply doesn't
  get that background check and falls back to layer 1 (or, below 1.8,
  to the original preview-only, copy-paste experience).

  Deployed at: https://graphica-signatures.pages.dev (Cloudflare Pages).
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>4c2f6a8e-9c1a-4e1b-8f2d-6a1e2b3c4d5e</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Graphica</ProviderName>
  <DefaultLocale>fr-CA</DefaultLocale>
  <DisplayName DefaultValue="Signature Graphica" />
  <Description DefaultValue="Aperçu de votre signature Graphica (bannières incluses) pendant que vous écrivez un courriel, avec possibilité d'utiliser une signature alternative pour un courriel en particulier." />
  <IconUrl DefaultValue="https://graphica-signatures.pages.dev/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://graphica-signatures.pages.dev/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://graphica.qc.ca" />

  <AppDomains>
    <AppDomain>https://graphica-signatures.pages.dev</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.9" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://graphica-signatures.pages.dev/taskpane.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.9">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />

          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="GraphicaSigGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="GraphicaSigButton">
                  <Label resid="ButtonLabel" />
                  <Supertip>
                    <Title resid="ButtonLabel" />
                    <Description resid="ButtonTooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- Mobile (Outlook for iOS/Android) picks up the same task pane
               command automatically where the platform supports Add-in
               commands; no separate FormFactor block is required for a
               simple "open task pane" button as of the current mobile
               requirement set. -->
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://graphica-signatures.pages.dev/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://graphica-signatures.pages.dev/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://graphica-signatures.pages.dev/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://graphica-signatures.pages.dev/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://graphica-signatures.pages.dev/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Graphica" />
        <bt:String id="ButtonLabel" DefaultValue="Aperçu signature" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonTooltip" DefaultValue="Affiche un aperçu de votre signature Graphica (avec bannières). Votre signature habituelle reste automatique ; vous pouvez aussi choisir une signature alternative pour ce courriel." />
      </bt:LongStrings>
    </Resources>

    <!--
      Nested VersionOverridesV1_1: adds the OnMessageSend LaunchEvent
      background safety check (see the top-of-file comment, layer 2). A
      client that supports V1_1 uses THIS block's Hosts/Resources entirely,
      in place of the V1_0 block above — so the button/task pane command is
      repeated here rather than merged with V1_0. A client that doesn't
      support V1_1 (below Mailbox 1.15) simply keeps using the V1_0 block
      above unchanged, with no LaunchEvent and no error.
    -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.15">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <!-- Event-based activation (the LaunchEvent below) runs in this
               lightweight runtime, separate from the task pane's own. -->
          <Runtimes>
            <Runtime resid="WebViewRuntime.Url">
              <!-- Used by classic Outlook on Windows, which runs the raw
                   script directly instead of the HTML wrapper. -->
              <Override type="javascript" resid="JSRuntime.Url" />
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="GraphicaSigGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="GraphicaSigButton">
                    <Label resid="ButtonLabel" />
                    <Supertip>
                      <Title resid="ButtonLabel" />
                      <Description resid="ButtonTooltip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Two background events share this one runtime:
                   - OnMessageSend: the send-time safety check (layer 2 - see
                     top-of-file comment). SendMode "SoftBlock" means: if the
                     add-in or its runtime is ever unavailable at send time,
                     Outlook fails open (lets the email send) rather than
                     getting anyone stuck.
                   - OnNewMessageCompose: fires the instant a compose window
                     opens (new email, reply, or forward - Microsoft's own
                     docs/issue tracker confirm it isn't limited to brand-new
                     mail), WITHOUT needing the task pane open. Lets someone
                     see the Graphica signature already in the body the
                     moment they start writing, instead of only after
                     clicking "Aperçu signature" - the same insert logic the
                     task pane already runs on its own first load, just
                     triggered earlier. Has no SendMode (that attribute is
                     specific to OnMessageSend) and never blocks anything -
                     if it fails or times out, the compose window is
                     unaffected; someone can still click the button
                     themselves exactly as before this was added. -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="SoftBlock" />
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler" />
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://graphica-signatures.pages.dev/assets/icon-16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://graphica-signatures.pages.dev/assets/icon-32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://graphica-signatures.pages.dev/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://graphica-signatures.pages.dev/commands.html" />
          <bt:Url id="Taskpane.Url" DefaultValue="https://graphica-signatures.pages.dev/taskpane.html" />
          <!-- Both point at the same handler code: WebViewRuntime.Url is
               the HTML wrapper (commands.html, which also loads
               launchevent.js) used by web/Mac/new-Windows Outlook;
               JSRuntime.Url is the raw script used by classic Windows
               Outlook, which runs it without an HTML wrapper. -->
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://graphica-signatures.pages.dev/commands.html" />
          <bt:Url id="JSRuntime.Url" DefaultValue="https://graphica-signatures.pages.dev/launchevent.js" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Graphica" />
          <bt:String id="ButtonLabel" DefaultValue="Aperçu signature" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ButtonTooltip" DefaultValue="Affiche un aperçu de votre signature Graphica (avec bannières). Votre signature habituelle reste automatique ; vous pouvez aussi choisir une signature alternative pour ce courriel." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
